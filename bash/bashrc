#----- Shell functions

# cd to current dir on lf quit
r() {
  command -v lf >/dev/null 2>&1 || {
    printf 'r: lf not found\n'
    return 127
  }

	local lf_cd_file dir

  lf_cd_file="$(mktemp "${TMPDIR:-/tmp}/lfcd.XXXXXX")" || return
  LF_CD_FILE="$lf_cd_file" command lf "$@"

  if [[ -s $lf_cd_file ]]; then
    dir="$(realpath -- "$(cat -- "$lf_cd_file")")" || {
      rm -f -- "$lf_cd_file"
      return 1
    }

    if [[ -d $dir && $dir != "$PWD" ]]; then
      cd -- "$dir" || {
        rm -f -- "$lf_cd_file"
        return 1
      }
    fi
  fi

  rm -f -- "$lf_cd_file"
}

# get file stats
fst() {
  [[ $# -eq 1 ]] || {
    printf 'usage: fst FILE\n' >&2
    return 2
  }

  case "${OSTYPE:-}" in
    linux-gnu*)
      stat --format '%a' -- "$1"
      ;;
    freebsd*|darwin*)
      stat -f '%Lp' -- "$1"
      ;;
    *) return 1 ;;
  esac
}

# pretty-print journalctl
jctl() {
  local cols width

  cols="$(tput cols 2>/dev/null || printf '120')"

  if (( cols < 121 )); then
    width=113
  else
    width=$((cols - 4))
  fi

  if command -v bat >/dev/null 2>&1; then
    journalctl --no-pager "$@" |
			bat --style=plain --language=log --wrap=character --terminal-width="$width"
  else
    journalctl "$@"
  fi
}

# file checksum
fsum() {
  case "${1-}" in
    -h|--help|'')
      cat <<'EOF'
usage: fsum [ARGS]
args:
  fsum CHECKSUM_FILE
  fsum SHA256 FILE
  fsum "SHA256  FILE"
EOF
      return 0
      ;;
  esac

  local expected file actual line

  case $# in
    1)
      if [[ -f $1 ]]; then
        sha256sum --check -- "$1"
        return
      fi

      line=$1
      expected="${line%%[[:space:]]*}"
      file="$(printf '%s' "$line" | sed -E 's/^[[:xdigit:]]{64}[[:space:]]+\*?//')"

      if [[ -z $expected || -z $file || $file == "$line" ]]; then
        printf 'fsum: invalid checksum line\n' >&2
        return 2
      fi
      ;;
    2)
      expected=$1
      file=$2
      ;;
    *)
      printf 'fsum: invalid arguments\n' >&2
      return 2
      ;;
  esac

  [[ -f $file ]] || {
    printf 'fsum: file not found: %s\n' "$file" >&2
    return 1
  }

  [[ $expected =~ ^[A-Fa-f0-9]{64}$ ]] || {
    printf 'fsum: invalid SHA256: %s\n' "$expected" >&2
    return 2
  }

  actual="$(sha256sum -- "$file" | awk '{print $1}')" || return

  if [[ "${actual,,}" == "${expected,,}" ]]; then
    printf 'Checksum OK\n'
    return 0
  fi

  printf 'Checksum failed\n' >&2
  printf 'expected: %s\nactual:   %s\n' "$expected" "$actual" >&2
  return 1
}

