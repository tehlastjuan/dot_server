#!/usr/bin/env bash

# cd to current dir on lf quit
r() {
  export LF_CD_FILE=/var/tmp/.lfcd-$$
  command lf "${@}"
  if [ -s "$LF_CD_FILE" ]; then
    local DIR
    DIR="$(realpath "$(cat "$LF_CD_FILE")")"
    if [ "$DIR" != "$PWD" ]; then
      cd "$DIR" || exit
    fi
    rm "$LF_CD_FILE"
  fi
  unset LF_CD_FILE
}

# fzf file opener
f() {
  local file
  file=$(fzf --query="$1" --select-1 --exit-0 --preview="$XDG_CONFIG_HOME/lf/preview {}")
  if [ -n "$file" ]; then
    case $(file --dereference --mime-type "$file" -b) in
      application/json) $EDITOR "$file" ;;
      text/*)           $EDITOR "$file" ;;
      *)                return 1 ;;
    esac
  fi
}

# get file stats
fst() {
  stat --format '%a' "${1-}"
}

# note ./here
nh() {
  case "${1-}" in
    -u|--unix) shift; $EDITOR "${1:-"note"}-$(date +%s).md" ;;
    *) $EDITOR "${1:-"note"}-$(date +%Y%m%d-%H%M%S).md" ;;
  esac
}

# git commit browser
gcb() {
  if git -C "$PWD" rev-parse --is-inside-work-tree &> /dev/null; then
    git log --color=always \
      --format="%C(auto)%h%d %s %C(blue)%C(bold)%ch" "$@" |
      fzf --ansi --no-sort --reverse --tiebreak=index \
        --bind=ctrl-s:toggle-sort \
        --preview="(git show --color=always \$(echo {} | grep -o '[a-f0-9]\{7\}'))"
  fi
}

# pretty-print journalctl
jctl() {
  local -i _cols
  local -i _width
  _cols=$(tput cols)
  if [ $_cols -lt 121 ]; then : 113; else : $((_cols - 4)); fi
  _width=$(printf '%s' "$_")

  local -a _cmd=()
  case "${1-}" in
    -h|--help)
      cat << EOT
usage: jctl [OPTS]
options:
  --sudo  :run as sudo
EOT
      return
      ;;
    --sudo)
      shift
      _cmd+=("sudo")
      ;;
  esac
  _cmd+=(
    "journalctl"
    "${@}"
    "| bat --style=plain --language=log --wrap=character --terminal-width=${_width}"
  )

  bash -c "${_cmd[*]}"
}

# SHA256 check
fsum() {
  __prt_info() {
    cat << EOT
usage: fsum [ARGS]
args:
  [FILE]
    read line 1 in [FILE] with "SHA256SUM  FILENAME"
  [STRING]
    read string "SHA256SUM  FILENAME"
  [SUM] [FILENAME]
    read \$1 "SHA256SUM", read \$2 "FILENAME"
EOT
  }

  case "${1-}" in
    -h|--help) __prt_info && return ;;
  esac

  local checksum filename
  local -i result=1
  set -x

  if [ -f "${1-}" ] && [ -f "${2-}" ]; then
    local _filepath_file _filepath_sum
    _filepath_file=$(realpath "$1")
    _filepath_sum=$(realpath "$2")

    pushd "$(dirname "$_filepath_file")" &> /dev/null &&
      checksum=$(sha256sum "${_filepath_file##*/}" &> /dev/null) &&
      popd &> /dev/null || exit

    if [[ "${3-}" =~ ^[0-9] ]] &&
      [ "$checksum" = "$(sed "${3}q;d" "$_filepath_sum")" ]; then result=0; fi
    if grep "$checksum" "$_filepath_sum" &> /dev/null; then result=0; fi

  else

    case $# in
      1)
        checksum=${1%  *}; filename=${1##*  }
        if [ "$(sha256sum "$filename" 2> /dev/null)" = "${checksum}  ${filename}" ]; then
          result=0
        fi
        ;;
      *)
        checksum=$1; filename=$2
        if [ "$(sha256sum "$filename" 2> /dev/null)" = "$checksum" ]; then
          result=0
        fi
        ;;
    esac
  fi

  if [ $result -eq 0 ]; then
    printf '%s\n' "Checksum OK" && return
  fi
  printf '%s\n' "Checksum failed" && false
  set +x
}
