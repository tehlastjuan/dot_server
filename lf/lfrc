#----- commands

# bulk-rename
cmd bulk-rename ${{
	command -v paste &> /dev/null || exit 1
	old="$(mktemp)"
	new="$(mktemp)"
	if [ -n "$fs" ]; then
		fs="$(basename -a -- $fs)"
	else
		fs="$(ls)"
	fi
	printf '%s\n' "$fs" > "$old"
	printf '%s\n' "$fs" > "$new"
	$EDITOR "$new"
	[ "$(wc -l < "$new")" -ne "$(wc -l < "$old")" ] && exit
	paste "$old" "$new" | while IFS= read -r names; do
			src="$(printf '%s' "$names" | cut -f1)"
			dst="$(printf '%s' "$names" | cut -f2)"
			if [ "$src" = "$dst" ] ||
				[ -e "$dst" ]; then continue; fi
			mv -- "$src" "$dst"
	done
	rm -rf -- "$old" "$new"
	lf -remote "send $id unselect"
}}

# y (select for copy) and P to paste symlink
cmd create-symlink %{{
	set -- $(cat ~/.local/share/lf/files)
	mode="$1"
	shift
	if [ "$#" -lt 1 ]; then
		lf -remote "send $id echoerr no files to link"
		exit
	fi
	ln -sr -t . -- "$@"
}}

# search in files w/ fzf
cmd fzf-search ${{
	command -v fzf &> /dev/null || exit 1
	declare -a preview=(
	  'declare -i lines=${FZF_PREVIEW_LINES};'
		'declare -i line=$(printf "%s" {2});'
		'declare -i center=$(( (lines - 3) / 2));'
		'if [ $line -lt $center ]; then center=$line; fi;'
		'declare -i start=$(( line - center ));'
		'declare -i end=$(( lines + start ));'
	)

  if command -v bat &> /dev/null; then
		preview+=(
			'bat --color=always --theme=TwoDark'
			'--number --tabs=2 --wrap=auto'
			'{1} --highlight-line $line'
			'--line-range $start:$end'
		)
	else
		preview+=('sed -n "${start},+${end}p" {1}')
	fi

	if command -v rg &> /dev/null; then
    IFS=$'\'' read -r cmd <<- EOT
rg \
--vimgrep \
--follow \
--hidden \
--no-ignore-vcs \
--smart-case \
--glob '!**/.cache/*' \
--glob '!**/.bare/*' \
--glob '!**/.git/*' \
--glob '!.bare' \
--glob '!.git' \
-- \
{q}
EOT
	else
    IFS=$'\'' read -r cmd <<- EOT
grep \
--dereference-recursive \
--binary-files=without-match \
--line-number \
--with-filename \
--exclude '!**/.cache/*' \
--exclude '!**/.bare/*' \
--exclude '!**/.git/*' \
--exclude '!.bare' \
--exclude '!.git' \
-- \
{q} \
.
EOT
	fi

	if [[ $PWD == "$HOME" ]]; then work_dir="~"
	else work_dir="${PWD##${HOME}/}"; fi

	if ! fzf \
		--header="Search in files: ${work_dir}" \
		--delimiter=: \
		--disabled \
		--preview-window 'right,~3,+{2}+3/2' \
		--bind="start:reload([ -n {q} ] && $cmd || true)" \
		--bind="change:reload([ -n {q} ] && $cmd || true)" \
		--bind='enter:become(lf -remote "send $id select \"$(printf "%s" {1} | sed '\''s/\\/\\\\/g;s/"/\\"/g'\'')\"")' \
		--preview="~/.config/lf/clean; $preview"; then
		exit 0
	fi
}}


# edit-with-sudo
cmd edit-with-sudo ${{
  set -- $(cat ~/.local/share/lf/files)
  mode="$1"
  shift
  sudo -e "$fx"
  rm ~/.local/share/lf/files
  lf -remote "send clear"
}}

# pager command
cmd pager ${{
  declare -i lines="$(tput lines 2> /dev/null || printf 40)"
  if [ -f "$f" ]; then
		declare -i f_lines=$(wc -l < "$f" 2> /dev/null || printf 0)
		if [ $f_lines -lt "$lines" ]; then exit 0; fi
		if command -v bat >/dev/null 2>&1; then
			bat -- "$f" \
			--color=always \
			--theme=TwoDark \
			--style=changes,numbers \
			--tabs=2 \
			--wrap=never \
			--paging=always
		else
			less -iWQMRX~ --no-vbell "$f"
		fi
	elif [ -d "$f" ]; then
		ls -la -- "$f" | less -iWQMRX~ --no-vbell
	else
		exit 1
	fi
}}

# open command
cmd open ${{
	if ! command -v file &> /dev/null; then exit 1; fi

	case $(file --dereference --mime-type --brief -- "$f") in
		application/json|text/*) "${EDITOR:-vim}" -- "$f" ;;
		*)
			if ! command -v xdg-open &> /dev/null; then
				exit 1
			fi
			xdg-open "$fx"
			;;
	esac
}}

# helper to cd to curr dir on quit
cmd quit-and-cd &{{
	pwd > $LF_CD_FILE
	lf -remote "send $id quit"
}}

# `set preview true` is a hack used to reload the preview
cmd scroll-preview &{{
	[[ -f $f ]] || exit 0

	declare -i offset
	declare -i f_lines
	declare -i max_offset

	offset=$((lf_user_preview_offset + $1))
	f_lines="$(wc -l < "$f" 2> /dev/null || printf 0)"
	max_offset=$(( f_lines - lf_height + 6 ))

	(( offset < 1 )) && offset=1
	(( offset >= max_offset )) && offset=$(( max_offset - 1 ))
	(( offset < 1 )) && offset=1

	lf -remote "send $id :set user_preview_offset $offset; set preview true"
}}

# preview toggle
cmd toggle-preview %{{
	case "$lf_preview" in
		true)
			lf -remote "send $id :set preview false; set ratios 1:5"
			;;
		false)
			lf -remote "send $id :set preview true; set ratios 1:2:3"
			;;
		*) exit 1 ;;
	esac
}}


