set shell bash
set shellopts '-eu'
set ifs "\n"

#----- settings

# formats
set cursorparentfmt "\033[7m"
set cursorpreviewfmt ""
set borderfmt "\033[01;35m"
set numberfmt "\033[30;49:1m"
set timefmt "_2/Jan/2006 15:04"
set infotimefmtnew "_2.Jan 15:04"
set infotimefmtold "_2.Jan  2006"
set promptfmt " \033[01;35m%d%S\033[01;35m%u@%h\033[0m "

# look'n feel
set anchorfind
set dircounts
set dirfirst
set drawbox
set hidden
set icons
set incsearch
set info size:time
set period 1
set ratios '1:2:3'
set relativenumber
set scrolloff 2
set smartcase
set sortby natural
set tabstop 2

# previews
set cleaner /root/.config/lf/clean
set previewer /root/.config/lf/preview
set preview


#----- commands

# Pager command
cmd pager ${{
  lines="$(tput lines @/dev/null || printf 40)"
  if [ -f $f ]; then
		f_lines="$(wc -l < "$f" 2> /dev/null || printf 0)"
		[[ $f_lines -lt $lines ]] && exit 0

		if command -v bat >/dev/null 2>&1; then
			bat -- "$f" \
			--color=always \
			--theme=TwoDark \
			--style=changes,numbers \
			--tabs=2 \
			--wrap=never \
			--paging=always
		else
			less -iWQMRX~ --no-vbell "$f"
		fi
	elif [[ -d "$f" ]]; then
		ls -la -- "$f" | less -iWQMRX~ --no-vbell
	else exit 1
	fi
}}

# Replace open command with robust selection of openers
cmd open ${{
	case $(file --dereference --mime-type --brief -- "$f") in
		application/json|text/*)
			"${EDITOR:-vim}" -- "$f"
			;;
		*) exit 1 ;;
	esac
}}

# helper to cd to curr dir on quit
cmd quit-and-cd &{{
	printf '%s\n' "$PWD" > $LF_CD_FILE
	lf -remote "send $id quit"
}}

# `set preview true` is a hack used to reload the preview
cmd scroll-preview &{{
	[[ -f $f ]] || exit 0

	declare -i offset
	declare -i f_lines
	declare -i max_offset

	offset=$((lf_user_preview_offset + $1))
	f_lines="$(wc -l < "$f" 2> /dev/null || printf 0)"
	max_offset=$(( f_lines - lf_height + 6 ))

	(( offset < 1 )) && offset=1
	(( offset >= max_offset )) && offset=$(( max_offset - 1 ))
	(( offset < 1 )) && offset=1

	lf -remote "send $id :set user_preview_offset $offset; set preview true"
}}


#----- command shortcuts

cmd on-select         set user_preview_offset 1

cmd reload-conf       $lf -remote "send $id source ~/.config/lf/lfrc"
cmd cd-back           $lf -remote "send $id cd \"$OLDPWD\""

cmd clear-all         :clear; visual-clear; select-clear
cmd select-all        :unselect; invert
cmd select-clear      :select-all; unselect

cmd sort-by-extension :set sortby ext; set info size:time
cmd sort-by-natural   :set sortby natural; set info size:time;
cmd sort-by-size      :set sortby size; set info size:time;
cmd sort-by-time      :set sortby time; set info size:time;


