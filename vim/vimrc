" STATUSLINE {{{

" Always display the Statusline.
set laststatus=2

" Reset statusline.
set statusline=

" Statusline functions:
function! StatuslineMode() abort
  let l:mode=mode(1)

  if l:mode ==# 'n'
    return '%#NormalMode# NORMAL '
  elseif l:mode ==# 'no'
    return '%#NormalMode# NORMAL '
  elseif l:mode ==# 'i'
    return '%#InsertMode# INSERT '
  elseif l:mode ==# 'c'
    return '%#CommandMode# COMMAND '
  elseif l:mode ==# 'v'
    return '%#VisualMode# VISUAL '
  elseif l:mode ==# 'V'
    return '%#VisualMode# V-LINE '
  elseif l:mode ==# "\<C-v>"
    return '%#VisualMode# V-BLOCK '
  elseif l:mode ==# 'R'
    return '%#ReplaceMode# REPLACE '
  elseif l:mode ==# 'Rv'
    return '%#ReplaceMode# V-REPLACE '
  elseif l:mode ==# 's'
    return '%#VisualMode# SELECT '
  elseif l:mode ==# 'S'
    return '%#VisualMode# S-LINE '
  elseif l:mode ==# "\<C-s>"
    return '%#VisualMode# S-BLOCK '
  elseif l:mode ==# 't'
    return '%#StatusLineTerm# TERM '
  elseif l:mode ==# '!'
    return '%#Warnings# SHELL '
  endif
  return '%#StatusLine# ' . l:mode . ' '
endfunction

" File name or else.
function! StatuslineFile() abort
  if empty(expand('%'))
    return '[No file]'
  endif
  return fnamemodify(getcwd(), ':~') . '/' . expand('%')
endfunction

" Read git branch if any.
function! GitBranch() abort
  let l:dir = expand('%:p:h')
  if empty(l:dir)
    let l:dir = getcwd()
  endif

  let l:git_dir = finddir('.git', l:dir . ';')
  if empty(l:git_dir)
    return ''
  endif

  let l:head = fnamemodify(l:git_dir, ':h') . '/.git/HEAD'
  if !filereadable(l:head)
    return ''
  endif

  let l:line = get(readfile(l:head, '', 1), 0, '')
  if l:line =~# '^ref: refs/heads/'
    return substitute(l:line, '^ref: refs/heads/', '', '')
  endif

  if !empty(l:line)
    return strpart(l:line, 0, 7)
  endif

  return ''
endfunction

" Show git branch if any.
function! StatuslineGit() abort
  let l:branch = GitBranch()
  return empty(l:branch) ? '' : l:branch . '*'
endfunction

" Build active Statusline
function! StatuslineActive() abort
  let l:line = ''

  " add buffer num
  if &buftype ==# 'terminal' ||
        \ &filetype ==# 'netrw' ||
        \ &filetype ==# 'help'
    return StatuslineInactive()
  else
    let l:line .= '%1* %n '
  endif
  " add vim mode & color
  let l:line .= StatuslineMode()
  " add git branch
  let l:branch = StatuslineGit()
  if !empty(l:branch)
    let l:line .= '%3* ' . l:branch . ' '
  endif
  " add server hostname
  if exists('$SSH_TTY')
    let l:line .= '%5* @' . hostname() . ' '
  endif
  " add filename
  let l:line .= '%1* %{StatuslineFile()}'
  " add file modified/readonly/top-bottom flag
  let l:line .= ' %m%r%w'
  " add separation
  let l:line .= '%1* %='
  " add paste indicator
  let l:line .= '%5*  %{&paste ? " [PASTE] " : ""}'
  " add file encoding + format + filetype
  let l:line .= '%2*  %{empty(&fileencoding) ? &encoding : &fileencoding}'
  let l:line .= '%2*  %{&fileformat}'
  let l:line .= '%3*  %{empty(&filetype) ? "noft" : &filetype}  '
  " add row:col
  let l:line .= '%4*  %l:%c  %6*'

  return l:line
endfunction

function! StatuslineInactive() abort
  return '%7* '
endfunction

" Statusline loader.
function! StatuslineLoad(mode) abort
  if a:mode ==# 'active'
    setlocal statusline=%!StatuslineActive()
  else
    setlocal statusline=%!StatuslineInactive()
  endif
endfunction

" Disable statusline for terminal, netwr and help buffers.
augroup user_statusline
  autocmd!
  autocmd WinEnter,BufWinEnter * call StatuslineLoad('active')
  autocmd WinLeave,BufWinLeave * call StatuslineLoad('inactive')
  if has ('ModeChanged')
    autocmd ModeChanged * redrawstatus
  endif
  autocmd FileType netrw setlocal nolist
augroup END

call StatuslineLoad('active')

