" UI {{{

" Show partial command you type in the last line of the screen.
set showcmd

" Hide the mode, we have a statusline.
set noshowmode

" Show current line number.
set number

" Show relative line numbers.
set relativenumber

" Show the cursor position all the time.
set ruler

" Do not let cursor scroll below or above N number of lines when scrolling.
set scrolloff=8

" Disable column highlight.
set nocursorcolumn

" Highlight current line number.
if exists('&cursorlineopt')
  set cursorline
  set cursorlineopt=number
endif

" Disable bells.
set noerrorbells
set novisualbell

if exists('&t_vb')
  set t_vb=
endif

" Disable modelines as a security precaution.
set modelines=0
set nomodeline

" Prefer splitting windows to the right.
set splitright
set splitbelow

" Do not hide markdown.
set conceallevel=0

" Command line height.
set cmdheight=1

" Adds 1 col space left to the numbers.
set foldcolumn=1

" Horizontal scrolling.
set sidescroll=1
set sidescrolloff=2

set display=lastline
"set display+=truncate

" have a fixed column for the diagnostics to appear in
" this removes the jitter when warnings/errors flow in.
if exists('&signcolumn')
  set signcolumn=yes
endif

" Hide tabline.
set showtabline=0

" Don't redraw while executing macros (good performance config).
" from: https://github.com/amix/vimrc/blob/master/vimrcs/basic.vim
set lazyredraw

" Cursor modes: Normal - Insert.
function! CursorShape() abort
  if has('gui_running')
    return
  endif

  if &term !~# '\v(xterm|screen|tmux|rxvt|st|alacritty|foot|kitty|linux|wezterm)'
    return
  endif

  let &t_SI = "\<esc>[6 q"
  let &t_EI = "\<esc>[2 q"

  if exists('&t_SR')
    let &t_SR = "\<esc>[4 q"
  endif
endfunction

function! CursorShapeReset() abort
  call CursorShape()
  silent! execute "normal! \<Esc>"
  silent! echon &t_EI
endfunction

" Reset the cursor on start.
augroup user_cursor_shape
  autocmd!
  autocmd VimEnter * call CursorShapeReset()
  autocmd VimLeave * silent! echon "\<ESC>[2 q"
augroup END

