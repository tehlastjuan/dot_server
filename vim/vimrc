" Open a terminal window.
if exists(':terminal') == 2
  nnoremap <silent> <C-/> :terminal<CR>
endif

" Close a terminal window.
tnoremap <silent> <C-/> <C-\><C-n>:bdelete!<CR>

" Esc to make the terminal scrollable,
" 'i' back to input mode.
