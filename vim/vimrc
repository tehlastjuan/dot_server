function! s:SetupWhitespaceMatches() abort
  if exists('w:trailing_whitespace_match')
    silent! call matchdelete(w:trailing_whitespace_match)
  endif
  if exists('w:leading_tabs_match')
    silent! call matchdelete(w:leading_tabs_match)
  endif

  let w:trailing_whitespace_match = matchadd('TrailingWhitespace', '\s\+$')
  let w:leading_tabs_match = matchadd('ExtraWhitespace', '^\t\+')
endfunction

