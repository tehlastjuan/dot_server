let g:netrw_banner = 0
let g:netrw_liststyle = 3  " default directory view. Cycle with i
let g:netrw_browse_split = 4
let g:netrw_altv = 1
let g:netrw_sort_sequence = '[\/]$,*'
let g:netrw_keepdir = 0
