nnoremap <silent> <C-Up>    <C-w>-
nnoremap <silent> <C-Right> <C-w><
nnoremap <silent> <C-Left>  <C-w>>

" Move between windows.
nnoremap <silent> <C-j> <C-w>j
nnoremap <silent> <C-k> <C-w>k
nnoremap <silent> <C-h> <C-w>h
nnoremap <silent> <C-l> <C-w>l

" Buffer prev/next.
nnoremap <silent> <leader>j :bprev<CR>
nnoremap <silent> <leader>k :bnext<CR>
nnoremap <silent> <C-,> :bprev<CR>
nnoremap <silent> <C-.> :bnext<CR>

" Close the current buffer.
nnoremap <silent> <leader>bd :bdelete<CR>

" Move the cursor based on physical lines, not the actual lines.
nnoremap <silent> <expr> j v:count == 0 ? 'gj' : 'j'
nnoremap <silent> <expr> k v:count == 0 ? 'gk' : 'k'
nnoremap <silent> <expr> 0 v:count == 0 ? 'g0' : '0'
nnoremap <silent> <expr> ^ v:count == 0 ? 'g^' : '^'
nnoremap <silent> <expr> $ v:count == 0 ? 'g$' : '$'

" auto indent format.
nnoremap <silent> <leader>cf :normal! mzgg=G`z<CR>

" Disable search highlights.
nnoremap <silent> <leader>h :nohlsearch<CR>
nnoremap <silent> <Esc><Esc> :nohlsearch<CR>

" Continuous visual shifting (does not exit Visual mode).
" `gv` means to reselect previous visual area.
" see: https://superuser.com/q/310417/736190
xnoremap < <gv
xnoremap > >gv

" Make Y consistent with C and D.
nnoremap Y y$

" enable/disable paste mode, allows usign shortcuts like jk.
if exists('&pastetoggle')
  set pastetoggle=<F2>
endif

" From `:help :DiffOrig`.
if exists(':DiffOrig') != 2
  command! DiffOrig vertical new |
        \ setlocal bt=nofile |
        \ r ++edit # |
        \ 0d_ |
        \ diffthis |
        \ wincmd p |
        \ diffthis
endif

