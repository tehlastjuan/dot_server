" References:
" - sensible.vim
" - https://www.freecodecamp.org/news/vimrc-configuration-guide-customize-your-vim-editor/
" - https://github.com/YanivZalach/Vim_Config_NO_PLUGINS/blob/main/.vimrc
" - https://github.com/blaenk/dots/blob/master/vim/.vimrc
" - https://stackoverflow.com/questions/48271865/vim-whats-the-best-way-to-set-statusline-color-to-change-based-on-mode
" - https://github.com/noahfrederick/vim-noctu/blob/master/colors/noctu.vim


" GENERAL {{{

" Disable vi compatibility, if for some reason it's on.
set nocompatible

" Default file encoding.
if has ('multi_byte')
  set encoding=utf-8
  scriptencoding utf-8
  set fileencodings=ucs-bom,utf-8,latin1
endif

" Default interface language.
if has('multi_lang')
  silent! language messages C
endif

if exists('&langmenu')
  set langmenu=none
endif

" Enable native mouse support.
if exists('&mouse')
  set mouse=a
endif

" SGR mouse support for older Vim/terminal setups.
" Modern Vim often auto-detects this; Neovim does not need this option.
if exists('&ttymouse') && has('mouse_sgr')
  set ttymouse=sgr
endif

" Do not load tohtml.vim
let g:loaded_2html_plugin = 1

" Enable the :Man command shipped inside Vim's man filetype plugin.
if exists(':Man') != 2 && !exists('g:loaded_man')
  runtime ftplugin/man.vim
endif

" Use less for keywordprg.
if empty($MANPAGER) || $MANPAGER !~# '^less\>'
  let $MANPAGER = 'less -R'
endif

if empty($PAGER) || $PAGER !~# '^less\>'
  let $PAGER = 'less'
endif

augroup user_keywordprg
  autocmd!
  autocmd FileType vim setlocal keywordprg=:help
augroup END

" }}}


" FILES {{{

" Enable type file detection &
" load indent file for the detected file type.
filetype plugin indent on

" Reload files changed outside vim.
set autoread

" Automatically :write before running commands.
set autowrite

"Return to last edit position when opening files.
function! GoToLastPosition() abort
  if &buftype !=# ''
    return
  endif
  if line("'\"") > 1 && line("'\"") <= line("$")
    silent! normal! g`"
  endif
endfunction

augroup user_go_to_last_position
  autocmd!
  autocmd BufReadPost * call GoToLastPosition()
augroup END

" Vim state directory.
let s:vim_state = expand('~/.local/state/vim')

if !empty(s:vim_state)
  try
    call mkdir(s:vim_state, 'p', 0700)
  catch
  endtry
endif

" OPT: Do not save backup files.
"set nobackup
"set nowritebackup
"set noswapfile

" Save backup & swap files to state dir.
if isdirectory(s:vim_state)
  let s:backup_dir = s:vim_state . '/backup'
  let s:swap_dir = s:vim_state . '/swap'

  try
    call mkdir(s:backup_dir, 'p', 0700)
    call mkdir(s:swap_dir, 'p', 0700)
  catch
  endtry

  if isdirectory(s:backup_dir)
    set backup
    set writebackup
    let &backupdir = s:backup_dir . '//'
  endif

  if isdirectory(s:swap_dir)
    set swapfile
    let &directory = s:swap_dir . '//'
  endif
endif

" Store vim state.
if isdirectory(s:vim_state)
  if exists('&viminfo')
    let &viminfo .= ',n' . s:vim_state . '/viminfo'
    if &viminfo !~# '!'
      set viminfo^=!
    endif
  endif

  " Keep undo history across sessions.
  if has('persistent_undo')
    let s:undo_dir = s:vim_state . '/undo'
    try
      call mkdir(s:undo_dir, 'p', 0700)
    catch
    endtry

    if isdirectory(s:undo_dir)
      let &undodir = s:undo_dir . '//'
      set undofile
    endif
  endif

  " Store netrw history.
  let g:netrw_home = s:vim_state
endif

" }}}


" EDITOR {{{

" Virtual edit for visual block edit.
set virtualedit=block

" Allow backspace in insert mode.
set backspace=indent,eol,start

"Time out on key codes but not mappings.
set notimeout
set timeoutlen=800
set ttimeout
set ttimeoutlen=100

" Max num of open tabs.
set tabpagemax=50

" Keep tabs in the bg.
set hidden

" Disable saving options in session and view files.
if exists('&sessionoptions')
  set sessionoptions-=options
endif

if exists('&viewoptions')
  set viewoptions-=options
endif

" Ignore certain files and folders when globbing
" Wild menu will ignore files with these extensions.
set wildignore+=*.docx,*.jpg,*.png,*.gif,*.pdf
set wildignore+=*.pyc,*.exe,*.flv,*.img,*.xlsx
set wildignore+=*.o,*.obj,*.bin,*.dll,*.exe
set wildignore+=*/.git/*,*/.svn/*,*/__pycache__/*,*/build/*
set wildignore+=*.pyc
set wildignore+=*.DS_Store
set wildignore+=*.aux,*.bbl,*.blg,*.brf,*.fls,*.fdb_latexmk,*.synctex.gz

" Delete comment character when joining commented lines.
set formatoptions+=c
set formatoptions+=q
set formatoptions+=j

" Correctly break multi-byte characters such as CJK.
" see https://stackoverflow.com/q/32669814/6064933
set formatoptions+=m
set formatoptions+=M

" Disable auto commenting on a new line.
augroup user_format_opts
  autocmd!
  autocmd Filetype * setlocal formatoptions-=c
        \ formatoptions-=r
        \ formatoptions-=o
augroup END

" Vim folds.
augroup user_fold_opts
  autocmd!
  autocmd FileType vim setlocal foldmethod=marker
        \ foldlevel=0
        \ foldlevelstart=-1
        \ keywordprg=:help
        \ formatoptions-=o
        \ formatoptions-=r
augroup END

" Enable fast tty support.
if exists('&ttyfast')
  set ttyfast
endif

" For regular expressions backwards comp.
set magic

" Set regular expression engine.
if exists('&regexpengine')
  set regexpengine=0
endif

" Base number when c-A & C-x for adds and subs.
set nrformats-=octal

" Do not override restricted/nologin shells.
if exists('$SHELL') && $SHELL =~# '\v/(false|nologin)$'
  " Keep Vim's restricted behavior.
elseif executable('/usr/bin/bash')
  set shell=/usr/bin/bash
elseif executable('/bin/bash')
  set shell=/bin/bash
elseif executable('/bin/sh')
  set shell=/bin/sh
endif

" OPT: Keep swap warnings visible.
" set shortmess+=A

" Do not add two spaces after a period when joining lines or formatting texts.
" see https://stackoverflow.com/q/4760428/6064933
set nojoinspaces

" Specify the behavior when switching between buffers.
if exists('&switchbuf')
  set switchbuf=useopen,usetab,newtab
endif
if exists('&showtabline')
  set showtabline=2
endif

" Disable a legacy behavior that can break plugin maps.
if exists('&langremap') && &langremap
  set nolangremap
endif

" Load matchit.vim, but only if the user hasn't installed a newer version.
if !exists('g:loaded_matchit')
  silent! runtime macros/matchit.vim
endif

" Open help vertically.
command! -bar -nargs=* -complete=help Help vertical belowright help <args>

augroup user_move_help
  autocmd!
  autocmd FileType help wincmd L
augroup END

" Remove trailing white space.
" see https://vi.stackexchange.com/a/456/15292
function! StripTrailingWhitespaces() abort
  let l:save = winsaveview()
  keeppatterns silent! %s/[ \t]\+$//e
  call winrestview(l:save)
endfunction

nnoremap <leader>s :call StripTrailingWhitespaces()<CR>

" }}}


" INDENTATION {{{

" Disable autoindentation
"set noautoindent
"set nosmartindent
set autoindent
set smartindent

" Use tabs instead of space characters
set noexpandtab

" Set shift width to 2 spaces.
set shiftwidth=2

" Set tab width to 2 columns.
set tabstop=2

" Spaces a tab counts while editing
set softtabstop=2

" Inserts blanks according to shiftwidth
" set smarttab

" Align indent to next multiple value of shiftwidth.
" see http://vim.1045645.n5.nabble.com/shiftround-option-td5712100.html
set shiftround

" Do not wrap lines. Allow long lines to extend as far as the line goes.
" set nowrap

" Alt: Wrap lines at convenient points
set wrap
set textwidth=120
set linebreak
set showbreak=~>

" Display tabs and trailing spaces.
if &encoding ==# 'utf-8'
  set listchars=tab:┆\ ,trail:·,extends:>,precedes:<,nbsp:␣
else
  set listchars=tab:>\ ,trail:_,extends:>,precedes:<,nbsp:+
endif
set list

" }}}


" TERMINAL {{{

" Do not use smart case in command line mode.
" from: https://vi.stackexchange.com/q/16509/15292
if exists('##CmdLineEnter')
  augroup user_cmdline_smartcase
    autocmd!
    autocmd CmdLineEnter : let s:save_smartcase = &smartcase | set nosmartcase
    autocmd CmdLineLeave : if exists('s:save_smartcase') |
          \ let &smartcase = s:save_smartcase |
          \ unlet s:save_smartcase |
          \ endif
  augroup END
endif

" Do not use number and relative number for terminal inside vim
if exists('##TermOpen')
  augroup term_settings
    autocmd!
    autocmd TermOpen * setlocal norelativenumber nonumber
    autocmd TermOpen * startinsert
    autocmd BufEnter * if &buftype ==# 'terminal' <bar> startinsert <bar> endif
  augroup END
endif

" }}}


" SEARCH {{{

" While searching though a file incrementally highlight
" matching characters as you type.
set incsearch

" Ignore case in pattern by default
set ignorecase

" Use case-sensitive to search specifically for capital letters
set smartcase

" Show matching words during a search
set showmatch
set matchtime=2

" Use highlighting when doing a search
set hlsearch

" Set the commands to save in history default number is 20
set history=10000

" }}}


" COMPLETION {{{

" Disable completing keywords in included files (e.g., #include in C).
" When configured properly, this can result in the slow, recursive scanning of
" hundreds of files of dubious relevance.
set complete-=i

" Avoid scanning unloaded buffers.
set complete-=u

" Avoid tag completion.
set complete-=t
"set complete-=w
"set complete-=b

" Scan files given by `dictionary` option.
set complete+=k

" OPT: Enable Spelling Suggestions for Auto-Completion.
"set complete+=kspell

" Show menu even if there is only one item.
set completeopt+=menu,menuone

" Disable the preview window.
set completeopt-=preview

" Spell language.
set spelllang=en

" Enable omni complete features
augroup user_completion
  autocmd!
  autocmd FileType * if empty(&l:omnifunc) && exists('*syntaxcomplete#Complete') |
        \ setlocal omnifunc=syntaxcomplete#Complete |
        \ endif
augroup END

" Enhanced command-line completion mode w\ popup menu.
set wildmenu

" List all matches without completing, then each full match >vim.
set wildmode=list:longest,full

" Popup menu height.
set pumheight=8

" Search for ./tags upward through ancestor directories.
if has('path_extra') && (',' . &g:tags . ',') =~# ',\./tags,'
  setglobal tags-=./tags tags-=./tags; tags^=./tags;
endif

" Minimalist-Tab Completion.
fun! TabComplete() abort
  if pumvisible()
    return "\<C-n>"
  endif

  let l:col = col('.') - 1
  if l:col > 0 && getline('.')[l:col - 1] =~ '\k'
    return "\<C-n>"
  endif

  return "\<Tab>"
endfun

inoremap <expr> <Tab> TabComplete()

" }}}


" MAPPINGS {{{

let g:mapleader = " "
let g:maplocalleader = ','

" Source current vimrc file.
nnoremap <silent> <leader>cs :execute 'source' fnameescape(expand('%:p'))<CR>

" Quit.
nnoremap <silent> <leader>qq :quitall<CR>

" Redraw window.
nnoremap <silent> <leader>r :redraw!<CR>

" ESC in insert mode.
inoremap <silent> jk <ESC>
inoremap <silent> kj <ESC>

" Resize windows with arrow keys.
" from: https://vim.fandom.com/wiki/Fast_window_resizing_with_plus/minus_keys
