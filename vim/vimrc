" LF INTEGRATION {{{

" a gem found in /usr/share/vim/vimfiles/syntax/lf.vim
if executable('lf')

  function! LF() abort
    let l:temp = tempname()

    execute 'silent !lf -selection-path=' . shellescape(l:temp)
    if v:shell_error
      redraw!
      echohl ErrorMsg
      echomsg 'lf exited with error'
      echohl None
      return
    endif

    if !filereadable(l:temp)
      redraw!
      return
    endif

    let l:names = readfile(l:temp)
    call delete(l:temp)

    if empty(l:names)
      redraw!
      return
    endif

    execute 'edit ' . fnameescape(l:names[0])
    for l:name in l:names[1:]
      execute 'argadd ' . fnameescape(l:name)
    endfor

    redraw!
  endfunction

  command! -bar LF call LF()

  " Open lf to navigate files
  nnoremap <silent> <leader>l :LF<CR>
endif

