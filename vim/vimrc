" Show highlight group.
function! SynStack() abort
  if !exists("*synstack")
    echo 'synstack() is not available'
    return
  endif

  let l:stack = map(synstack(line('.'), col('.')), 'synIDattr(v:val, "name")')
  if empty(l:stack)
    echo 'No syntax group under cursor'
    return
  else
    echo 'stack: ' . join(l:stack, ' -> ')
  endif

  let l:id = synID(line('.'), col('.'), 1)
  echo 'effective: ' . synIDattr(l:id, 'name') . ' -> ' . synIDattr(synIDtrans(l:id), 'name')
endfunc

nnoremap <leader>; :call SynStack()<CR>

" Comment-toggle for blocks of code.
" https: //stackoverflow.com/questions/1676632/whats-a-quick-way-to-comment-uncomment-lines-in-vim
let s:comment_map = {
      \ 'ahk':          ';',
      \ 'bash_profile': '#',
      \ 'bashrc':       '#',
      \ 'bat':          'REM',
      \ 'c':            '//',
      \ 'conf':         '#',
      \ 'cpp':          '//',
      \ 'desktop':      '#',
      \ 'eml':          '>',
      \ 'fstab':        '#',
      \ 'go':           '//',
      \ 'java':         '//',
      \ 'javascript':   '//',
      \ 'lua':          '--',
      \ 'mail':         '>',
      \ 'php':          '//',
      \ 'profile':      '#',
      \ 'python':       '#',
      \ 'ruby':         '#',
      \ 'rust':         '//',
      \ 'scala':        '//',
      \ 'sh':           '#',
      \ 'tex':          '%',
      \ 'vim':          '"',
      \ }

function! s:CommentLeader() abort
  if &commentstring =~# '%s'
    let l:leader = substitute(&commentstring, '\s*%s.*$', '', '')
    if !empty(l:leader)
      return l:leader
    endif
  endif
  return get(s:comment_map, &filetype, '')
endfunction

function! ToggleCommentRange(first, last) abort
  let l:leader = s:CommentLeader()
  if empty(l:leader)
    echo 'No comment leader found for filetype: ' . &filetype
    return
  endif

  let l:leader_re = escape(l:leader, '\.^$~[]*')
  let l:all_commented = 1

  for l:num in range(a:first, a:last)
    let l:line = getline(l:num)
    if l:line =~# '^\s*$'
      continue
    endif
    if l:line !~# '^\s*' . l:leader_re
      let l:all_commented = 0
      break
    endif
  endfor

  for l:num in range(a:first, a:last)
    let l:line = getline(l:num)
    if l:line =~# '^\s*$'
      continue
    endif
    if l:all_commented
      call setline(l:num, substitute(l:line, '^\(\s*\)' . l:leader_re . '\s\?', '\1', ''))
    else
      call setline(l:num, substitute(l:line, '^\(\s*\)', '\1' . l:leader . ' ', ''))
    endif
  endfor
endfunction

nnoremap <silent> gcc :call ToggleCommentRange(line('.'), line('.'))<CR>
xnoremap <silent> gc :<C-u>call ToggleCommentRange(line("'<"), line("'>"))<CR>

